datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Rol del usuario (FK a Role)
  roleId        String?
  userRole      Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  password      String?

  // Profile fields
  firstName      String?
  lastName       String?
  documentType   String?
  documentNumber String?
  phone          String?
  gender         String?
  birthDate      DateTime?
  maritalStatus  String?
  hasChildren    Boolean   @default(false)
  childrenCount  Int       @default(0)
  country        String?
  city           String?
  address        String?
  neighborhood   String?
  isActive       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Red (un usuario solo puede pertenecer a una red)
  networkId   String?
  network     Network? @relation(fields: [networkId], references: [id], onDelete: SetNull)
  networkRole String?  // 'leader' | 'member'

  // Grupo (un usuario solo puede pertenecer a un grupo)
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupRole String?  // 'leader' | 'member'

  // Reportes creados
  groupReports     GroupReport[]

  // Eventos de calendario creados
  calendarEvents   CalendarEvent[]

  // Instituto Life
  ilTags               ILUserTag[]    @relation("ILUserTagUser")
  ilTagsAssigned       ILUserTag[]    @relation("ILUserTagAssigner")
  ilEnrollments        ILEnrollment[] @relation("ILEnrollmentStudent")
  ilEnrollmentsApproved ILEnrollment[] @relation("ILEnrollmentApprover")
  ilBadges             ILBadge[]      @relation("ILBadgeUser")
  ilCohortsTeaching    ILCohort[]     @relation("ILCohortTeacher")
  ilAttendanceMarked   ILAttendance[] @relation("ILAttendanceMarker")
  ilGradesGiven        ILGrade[]      @relation("ILGradeGrader")

  // Solicitudes Interáreas
  areaMemberships          AreaMembership[]
  solicitudesCreadas       Solicitud[]           @relation("SolicitudCreator")
  solicitudesCanceladas    Solicitud[]           @relation("SolicitudCanceler")
  solicitudAreasRevisadas  SolicitudArea[]       @relation("SolicitudAreaReviewer")
  informesCreados          InformeEvento[]       @relation("InformeCreator")
  comentariosSolicitud     SolicitudComentario[] @relation("SolicitudComentarioAutor")
  solicitudEventos         SolicitudEvento[]     @relation("SolicitudEventoActor")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  colors      Json?    // e.g., { primary: "#0466C8", secondary: "#001845" }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  roles           Role[]
  networks        Network[]
  groups          Group[]
  groupReports    GroupReport[]
  calendarEvents  CalendarEvent[]
  vacationPeriods VacationPeriod[]

  // Instituto Life
  ilCourses  ILCourse[]
  ilCohorts  ILCohort[]

  // Solicitudes Interáreas
  areas        Area[]
  solicitudes  Solicitud[]
}

// ===================
// Módulo de Roles y Permisos
// ===================

model Role {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  hierarchy      Int      // 1 = más poder (Admin=1, Aux=2, Pastor=3, Líder=4, Voluntario=5, Usuario=6)
  isSystem       Boolean  @default(false) // Roles protegidos (Admin, Usuario) no se pueden eliminar
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  permissions    RolePermission[]
  users          User[]
}

model Permission {
  id          String @id @default(cuid())
  module      String // "usuarios", "redes", "grupos", "reportes", "calendario", "configuracion", "roles", "dashboard"
  action      String // "ver", "crear", "editar", "eliminar", "exportar"
  description String // "Ver lista de usuarios"

  roles       RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===================
// Módulo de Redes
// ===================

model Network {
  id             String   @id @default(cuid())
  name           String
  description    String?
  imageUrl       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Usuarios que pertenecen a esta red (como líderes o miembros)
  users          User[]

  // Grupos de esta red
  groups         Group[]
}

// ===================
// Módulo de Grupos
// ===================

model Group {
  id             String   @id @default(cuid())
  name           String
  description    String?
  imageUrl       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relación con Red (obligatoria)
  networkId      String
  network        Network  @relation(fields: [networkId], references: [id], onDelete: Cascade)

  // Organización
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Modalidad: 'virtual' | 'presencial'
  modality       String   @default("presencial")

  // Ubicación (solo para presencial)
  city           String?
  address        String?
  neighborhood   String?

  // Horario de reunión
  meetingDay     String?  // lunes, martes, etc.
  meetingTime    String?  // "19:00"

  // Miembros del grupo (líderes y miembros)
  members        User[]

  // Reportes de este grupo
  reports        GroupReport[]
}

// ===================
// Módulo de Reportes
// ===================

model GroupReport {
  id              String   @id @default(cuid())

  // Fecha de la reunión (solo fecha, sin hora)
  meetingDate     DateTime @db.Date

  // Asistencia
  totalAttendees  Int      // Total asistentes (incluye líderes)
  leadersCount    Int      // Cuántos eran líderes
  visitorsCount   Int      // Cuántos fueron visitas

  // Ofrenda
  reportOffering  Boolean  @default(false)
  offeringAmount  Decimal? @db.Decimal(10, 2)

  // Notas (opcional)
  notes           String?

  // Grupo no realizado
  noMeeting       Boolean  @default(false)
  noMeetingReason String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  groupId         String
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  reporterId      String   // Usuario que creó el reporte
  reporter        User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([groupId, meetingDate])  // Un reporte por grupo por fecha
}

// ===================
// Módulo de Vacaciones
// ===================

model VacationPeriod {
  id             String   @id @default(cuid())
  name           String?  // e.g., "Vacaciones Diciembre 2026"
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ===================
// Módulo de Calendario
// ===================

model CalendarEvent {
  id             String   @id @default(cuid())
  title          String
  description    String?

  // Fechas
  startDate      DateTime
  endDate        DateTime
  allDay         Boolean  @default(false)

  // Categoría: 'culto' | 'evento' | 'reunion' | 'actividad' | 'capacitacion'
  category       String   @default("evento")

  // URL externa opcional (para más info)
  url            String?

  // Ubicación
  location       String?

  // Estado
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relaciones
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ===================
// Módulo Instituto Life
// ===================

model ILCourse {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  description      String?
  imageUrl         String?
  evaluationType   String      // 'graded' | 'pass_fail'
  evaluationConfig Json        // configuración de evaluación
  isActive         Boolean     @default(true)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  levels           ILLevel[]
  cohorts          ILCohort[]
  badges           ILBadge[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model ILLevel {
  id                   String    @id @default(cuid())
  courseId             String
  course               ILCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String
  sortOrder            Int
  sessionCount         Int
  evaluationConfig     Json?     // override opcional
  prerequisiteLevelId  String?
  prerequisiteLevel    ILLevel?  @relation("LevelPrerequisite", fields: [prerequisiteLevelId], references: [id])
  nextLevels           ILLevel[] @relation("LevelPrerequisite")
  isActive             Boolean   @default(true)
  cohorts              ILCohort[]
  badges               ILBadge[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([courseId, slug])
}

model ILCohort {
  id             String        @id @default(cuid())
  levelId        String
  level          ILLevel       @relation(fields: [levelId], references: [id], onDelete: Cascade)
  courseId       String
  course         ILCourse      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        User          @relation("ILCohortTeacher", fields: [teacherId], references: [id])
  name           String?
  weekDay        String        // 'lunes' | 'martes' | ... | 'domingo'
  startTime      String        // '09:00'
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  maxCapacity    Int
  status         String        @default("upcoming") // 'upcoming' | 'active' | 'completed' | 'cancelled'
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions       ILSession[]
  enrollments    ILEnrollment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ILSession {
  id            String       @id @default(cuid())
  cohortId      String
  cohort        ILCohort     @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  sessionNumber Int
  scheduledDate DateTime     @db.Date
  topic         String?
  status        String       @default("scheduled") // 'scheduled' | 'completed' | 'cancelled'
  attendance    ILAttendance[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([cohortId, sessionNumber])
}

model ILEnrollment {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation("ILEnrollmentStudent", fields: [userId], references: [id], onDelete: Cascade)
  cohortId     String
  cohort       ILCohort      @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  status       String        @default("pending") // 'pending' | 'approved' | 'rejected' | 'active' | 'completed' | 'failed' | 'withdrawn'
  enrolledAt   DateTime      @default(now())
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?         @relation("ILEnrollmentApprover", fields: [approvedById], references: [id])
  completedAt  DateTime?
  finalGrade   Decimal?      @db.Decimal(5, 2)
  passed       Boolean?
  attendance   ILAttendance[]
  grades       ILGrade[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, cohortId])
}

model ILAttendance {
  id           String       @id @default(cuid())
  sessionId    String
  session      ILSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   ILEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  present      Boolean
  markedById   String
  markedBy     User         @relation("ILAttendanceMarker", fields: [markedById], references: [id])
  markedAt     DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([sessionId, enrollmentId])
}

model ILGrade {
  id           String       @id @default(cuid())
  enrollmentId String
  enrollment   ILEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  component    String       // 'test' | 'lectura' | 'asistencia' | 'participacion'
  score        Decimal      @db.Decimal(5, 2)
  gradedById   String
  gradedBy     User         @relation("ILGradeGrader", fields: [gradedById], references: [id])
  gradedAt     DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([enrollmentId, component])
}

model ILBadge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("ILBadgeUser", fields: [userId], references: [id], onDelete: Cascade)
  badgeType String    // 'course_completed' | 'level_completed'
  courseId  String
  course    ILCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  levelId   String?
  level     ILLevel?  @relation(fields: [levelId], references: [id])
  earnedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, badgeType, courseId, levelId])
}

model ILUserTag {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("ILUserTagUser", fields: [userId], references: [id], onDelete: Cascade)
  tag          String   // 'coordinador' | 'maestro' | 'estudiante'
  assignedById String
  assignedBy   User     @relation("ILUserTagAssigner", fields: [assignedById], references: [id])
  isActive     Boolean  @default(true)
  assignedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, tag])
}

// ===================
// Módulo Solicitudes Interáreas
// ===================

enum TipoEvento {
  SERVICIO
  EVENTO_ESPECIAL
  REUNION_INTERNA
  OTRO
}

enum EstadoSolicitudArea {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum CumplimientoProgramacion {
  SI
  PARCIAL
  NO
}

enum AreaMembershipRole {
  LIDER
  MIEMBRO
}

model Area {
  id             String   @id @default(cuid())
  name           String
  slug           String
  description    String?
  icon           String?
  color          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberships        AreaMembership[]
  solicitudAreas     SolicitudArea[]
  solicitudesOrigen  Solicitud[]      @relation("AreaSolicitante")

  @@unique([organizationId, slug])
}

model AreaMembership {
  id        String             @id @default(cuid())
  areaId    String
  area      Area               @relation(fields: [areaId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AreaMembershipRole @default(MIEMBRO)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([areaId, userId])
  @@index([userId, role])
  @@index([areaId, role])
}

model Solicitud {
  id                String   @id @default(cuid())

  // Solicitante
  createdById       String
  createdBy         User     @relation("SolicitudCreator", fields: [createdById], references: [id], onDelete: Restrict)
  areaSolicitanteId String
  areaSolicitante   Area     @relation("AreaSolicitante", fields: [areaSolicitanteId], references: [id], onDelete: Restrict)
  cargoRol          String?
  telefonoContacto  String?
  emailContacto     String?

  // Evento
  nombreEvento      String
  tipoEvento        TipoEvento
  tipoEventoOtro    String?
  fechaEvento       DateTime @db.Date
  horaInicio        String   // "HH:mm"
  horaFin           String   // "HH:mm"
  lugar             String

  // Actividad
  descripcionActividad   String  @db.Text
  materialesDisponibles  String? @db.Text

  // Enfoque
  propositoEvento     String  @db.Text
  objetivoEspecifico  String  @db.Text
  dirigidoA           String
  resultadoEsperado   String  @db.Text

  // Plazos / difusión
  fechaLimite          DateTime  @db.Date
  requiereDifusion     Boolean   @default(false)
  inicioComunicacion   DateTime? @db.Date

  // Flags
  confirmacion15Dias Boolean @default(false)
  urgente            Boolean @default(false)

  // Cancelación (soft)
  cancelada       Boolean   @default(false)
  canceladaById   String?
  canceladaBy     User?     @relation("SolicitudCanceler", fields: [canceladaById], references: [id])
  canceladaMotivo String?
  canceladaAt     DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  areas       SolicitudArea[]
  comentarios SolicitudComentario[]
  eventos     SolicitudEvento[]
  informe     InformeEvento?

  @@index([organizationId, createdAt])
  @@index([createdById, cancelada])
  @@index([areaSolicitanteId])
  @@index([fechaEvento])
}

model SolicitudArea {
  id                String              @id @default(cuid())
  solicitudId       String
  solicitud         Solicitud           @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  areaId            String
  area              Area                @relation(fields: [areaId], references: [id], onDelete: Restrict)
  detalleEspecifico String              @db.Text
  estado            EstadoSolicitudArea @default(PENDIENTE)
  revisadoById      String?
  revisadoBy        User?               @relation("SolicitudAreaReviewer", fields: [revisadoById], references: [id])
  revisadoAt        DateTime?
  motivoRechazo     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  eventos SolicitudEvento[]

  @@unique([solicitudId, areaId])
  @@index([areaId, estado])
  @@index([solicitudId])
}

model InformeEvento {
  id          String    @id @default(cuid())
  solicitudId String    @unique
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User      @relation("InformeCreator", fields: [createdById], references: [id], onDelete: Restrict)

  // Desarrollo
  desarrolloTexto       String                   @db.Text
  cumplimiento          CumplimientoProgramacion
  cambiosUltimoMomento  String?                  @db.Text

  // Resultados
  objetivoCumplido      String @db.Text
  resultadosDestacados  String @db.Text

  // Evaluación 1-5
  evalOrganizacion   Int
  evalComunicacion   Int
  evalTrabajoEquipo  Int
  evalTiempos        Int
  evalEjecucion      Int

  // Aprendizajes
  saliBien String @db.Text
  noSalio  String @db.Text
  mejoras  String @db.Text

  // Materiales (URLs)
  linkFotos          String?
  linkVideos         String?
  linkPiezas         String?
  linkPresentaciones String?
  otrosLinks         String? @db.Text

  // Cierre
  recomendaciones        String? @db.Text
  comentariosAdicionales String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SolicitudComentario {
  id          String    @id @default(cuid())
  solicitudId String
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  autorId     String
  autor       User      @relation("SolicitudComentarioAutor", fields: [autorId], references: [id], onDelete: Restrict)
  texto       String    @db.Text
  createdAt   DateTime  @default(now())

  @@index([solicitudId, createdAt])
}

model SolicitudEvento {
  id              String         @id @default(cuid())
  solicitudId     String
  solicitud       Solicitud      @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  solicitudAreaId String?
  solicitudArea   SolicitudArea? @relation(fields: [solicitudAreaId], references: [id], onDelete: SetNull)
  tipo            String         // 'CREADA' | 'EDITADA' | 'CANCELADA' | 'APROBADA_AREA' | 'RECHAZADA_AREA' | 'COMENTARIO' | 'INFORME_CREADO' | 'INFORME_EDITADO'
  fromEstado      String?
  toEstado        String?
  actorId         String
  actor           User           @relation("SolicitudEventoActor", fields: [actorId], references: [id], onDelete: Restrict)
  motivo          String?
  metadata        Json?
  createdAt       DateTime       @default(now())

  @@index([solicitudId, createdAt])
}
